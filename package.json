{
  "name": "markdown-viewer",
  "version": "1.2.0",
  "description": "Minimal, native, green (portable) Markdown viewer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac zip",
    "pack:mac": "bash tools/build-macos.sh",
    "pack:linux": "bash tools/build-linux.sh",
    "pack:win": "powershell -ExecutionPolicy Bypass -File tools/build-windows.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.10",
    "mermaid": "^11.17.1"
  },
  "build": {
    "appId": "com.example.markdownviewer",
    "productName": "Markdown Viewer",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "afterSign": "scripts/after-sign.cjs",
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "role": "Viewer"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "mimeType": "text/markdown"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "role": "Viewer"
        }
      ]
    },
    "npmRebuild": false
  }
}
